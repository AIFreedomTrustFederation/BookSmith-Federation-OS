{
  "name": "booksmith-federation-os",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, AI-native, federated web operating system for knowledge creation and publishing.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "corepack pnpm --filter @booksmith-federation-os/web-os dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0",
    "pnpm": "10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
